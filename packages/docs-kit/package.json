{
  "name": "@timmo001/docs-kit",
  "version": "0.1.0",
  "description": "Shared branding, layout and config for timmo001 documentation sites",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./blume": "./src/blume/index.ts",
    "./blume/header-search.astro": "./src/blume/header-search.astro",
    "./blume/home-banner.astro": "./src/blume/home-banner.astro",
    "./blume/theme.css": "./src/blume/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmo001/docs-kit.git",
    "directory": "packages/docs-kit"
  },
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck format:check",
    "lint": "oxlint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "blume": "2.2.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@timmo001/oxlint-rules": "0.5.0",
    "@types/bun": "1.4.2",
    "blume": "2.2.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
