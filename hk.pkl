// Pre-push checks: the shared base from timmo001/workflows, plus every
// package's lint, type-check and formatting. Run them by hand with `hk check`.
amends "package://github.com/timmo001/workflows/releases/download/20261027.0/hk-base@20261027.0.0#/base.pkl"

hooks {
  ["pre-push"] {
    steps {
      ["check"] {
        check = "mise run check"
      }
    }
  }
}
