---
import tokens from "@groundwork/tokens/themes.json";

const core = tokens.themes.filter((theme) => !theme.optional);
---

<div class="grid">
  {
    core.map((theme) => (
      <a class="card" href={`/themes/${theme.id}`}>
        <div class="split">
          <div class="half" data-ds-mode="light" data-ds-theme={theme.id}>
            <span class="name">{theme.name}</span>
            <span class="pill">Accent</span>
          </div>
          <div class="half" data-ds-mode="dark" data-ds-theme={theme.id}>
            <span class="name">{theme.name}</span>
            <span class="pill">Accent</span>
          </div>
        </div>
        <p class="description">{theme.description}</p>
      </a>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .card {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    border: 1px solid #8884;
    border-radius: 12px;
  }

  .card:hover {
    border-color: #888a;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .half {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding: 1rem;
    font-family: var(--ds-font-sans);
    color: var(--ds-color-text-strong);
    background: var(--ds-color-surface-raised);
    background-image: var(--ds-panel-sheen);
    border-top: var(--ds-panel-flange) solid var(--ds-color-accent);
  }

  .name {
    font-weight: var(--ds-font-weight-strong);
    text-transform: var(--ds-label-transform);
    letter-spacing: var(--ds-label-tracking);
  }

  .pill {
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
    font-weight: var(--ds-font-weight-strong);
    color: var(--ds-color-on-accent);
    background: var(--ds-color-fill-accent-resting);
    border-radius: var(--ds-radius-control);
  }

  .description {
    margin: 0;
    padding: 0.75rem 1rem 1rem;
    font-size: 0.875rem;
  }
</style>
